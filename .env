DATABASE_URL=sqlite://./db_v2.sqlite3

# Configuration for RustDest API server

# Secret data used in creating session IDs; used to keep
# sessions valid across server restart
# Insert a secure random value generated via 'openssl rand -base64 32' here
# If empty, a new random value will be generated on every
# server start, invalidating all existing sessions
SECRET_KEY=BJzYZOSZyT6oNVn/Kw229R+qtOrLsLK6lLkE73k+9lk=

# Imprint information; can be empty. Note: No HTML possible!
IMPRINT_NAME="Michael Sonntag"
IMPRINT_MAIL="michael@sonntag.cc"
IMPRINT_COMPANY=
IMPRINT_WEBSITE="https://www.sonntag.cc"

# MaxMind account id (for GeoIP updates)
GEOIPUPDATE_ACCOUNT_ID=
# MaxMind license key (for GeoIP updates); must support "GeoLite2-City"
GEOIPUPDATE_LICENSE_KEY=

# Domain name of the server, e.g. www.acme.org
SERVER_DOMAIN_NAME=127.0.0.1

### FOR DEVELOPMENT ONLY ###
# Inserts test data into the database
DO_CREATE_TEST_DATA=true
# Config necessary for running in editor
GEODB_PATH="./data/GeoLite2-City.mmdb"
DB_PATH="./data/database.db"
DEVELOPMENT=true

# Only allow logged-in users to control other systems: Y/N
LOGGED_IN_ONLY="N"
# Always use the relay, even within the same subnet: Y/N
ALWAYS_USE_RELAY="N"
# Enforce access checks (requires the API server!): Y/N/T
# (T=Test; check permissions and log result, but always grant anyway)
ENFORCE_ACCESS_CHECKS="T"
